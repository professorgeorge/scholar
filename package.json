{
  "name": "scholarly-portal",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/build-profile.mjs",
    "preview": "vite preview",
    "test": "node --test scripts/*.test.mjs",
    "check": "node scripts/cv-update.mjs validate && tsc --noEmit",
    "cv:prepare": "node scripts/cv-update.mjs prepare",
    "cv:propose": "node scripts/cv-update.mjs propose",
    "cv:review": "node scripts/cv-update.mjs review",
    "cv:apply": "node scripts/cv-update.mjs apply",
    "cv:watch": "node scripts/watch-cv.mjs",
    "cv:refresh": "node scripts/refresh-cv.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
